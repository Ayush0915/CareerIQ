# ── LLM (OpenRouter) ──────────────────────────────────────────────────────────
# Free key, no card required: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# ⚠ REQUIRED FOR FREE MODELS — this is an account setting, not a config value.
# Enable BOTH toggles at https://openrouter.ai/settings/privacy :
#     Free endpoints that may train on request data
#     Free endpoints that may publish prompts
# With either one off, OpenRouter filters out every free endpoint and returns
#     404 No endpoints available matching your guardrail restrictions...
# for every model below — which reads like a broken model list and is not.
# Those providers may train on, and may publish, what you send them. Resume PII
# is stripped before any prompt leaves the process (backend/core/redact.py),
# but the resume body still goes. If that trade is unacceptable, add credit and
# switch to paid endpoints instead.

# ── Models — free tier by default ─────────────────────────────────────────────
# Everything below is $0 in and out. Two different questions, two commands:
#
#   python scripts/check_models.py --validate --deep   # do MY models answer?
#   python scripts/check_models.py --audit             # which free ones answer?
#
# Use --deep. Plain --validate only checks that an ID exists in the catalogue,
# and existence is not reachability: thinkingmachines/inkling:free sat in this
# file for several commits, passed --validate every time, and returned
# "403 only available on agentic harnesses" to every real request.
#
# Free-tier realities, stated plainly:
#   * Schema enforcement is not guaranteed. The app negotiates downwards
#     automatically (strict schema -> JSON mode -> prompt-only) and validates
#     the result either way.
#   * Rate limits are roughly 20 requests/minute and 200/day per account.
#     One resume analysis is 1 call; one AI Coach panel is 1 more.
#   * Free models get saturated and answer 429. That is why there are three
#     fallbacks, not one.
#   * Free models can be withdrawn without notice. Re-run --audit if calls
#     start failing.
PRIMARY_MODEL=nvidia/nemotron-3-super-120b-a12b:free
FALLBACK_MODELS=nvidia/nemotron-3-nano-30b-a3b:free,nvidia/nemotron-3-ultra-550b-a55b:free

# Lower-stakes, higher-volume generative features.
FAST_PRIMARY_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
FAST_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3.5-lightning:free

# auto | strict | json_object | prompt
# "auto" tries schema enforcement first and falls back if the model cannot do
# it, remembering what worked. Force "prompt" if you want zero negotiation.
STRUCTURED_OUTPUT_MODE=auto

# ── Live job search ───────────────────────────────────────────────────────────
# Optional. Without it the app falls back to the free Remotive API.
RAPIDAPI_KEY=

# ── Runtime ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development

# Enable ONLY behind a proxy that overwrites X-Forwarded-For (Render, Vercel,
# Cloudflare). The header is caller-supplied and therefore spoofable by anyone
# who can reach the app directly, so leave this off locally.
TRUST_PROXY_HEADERS=false

RATE_LIMIT=5/minute
